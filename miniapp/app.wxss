page {
  background: #f6f8fb;
  color: #0f172a;
  font-size: 28rpx;
}

.container {
  padding: 28rpx 24rpx 40rpx;
}

.hero {
  border-radius: 32rpx;
  padding: 32rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #0f766e 0%, #10b981 42%, #38bdf8 100%);
  box-shadow: 0 20rpx 48rpx rgba(15, 118, 110, 0.18);
}

.hero-title {
  font-size: 54rpx;
  line-height: 1.15;
  font-weight: 800;
}

.hero-desc {
  margin-top: 18rpx;
  font-size: 28rpx;
  line-height: 1.7;
  opacity: 0.95;
}

.badge-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.badge {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  color: #ffffff;
  font-size: 22rpx;
}

.card {
  margin-top: 24rpx;
  border-radius: 28rpx;
  background: #ffffff;
  padding: 28rpx;
  box-shadow: 0 14rpx 36rpx rgba(15, 23, 42, 0.06);
}

.section-title {
  font-size: 38rpx;
  font-weight: 800;
  margin-bottom: 10rpx;
}

.section-desc {
  font-size: 26rpx;
  line-height: 1.7;
  color: #64748b;
}

.grid-2 {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.stack {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.module-card {
  border-radius: 24rpx;
  padding: 24rpx;
  color: #0f172a;
  background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
  border: 2rpx solid #e2e8f0;
}

.module-card__title {
  font-size: 32rpx;
  font-weight: 700;
}

.module-card__desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #64748b;
}

.button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  min-height: 84rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #0f766e 0%, #14b8a6 100%);
  color: #ffffff;
  border: none;
}

.button--light {
  background: #ffffff;
  color: #0f766e;
  border: 2rpx solid rgba(15, 118, 110, 0.18);
}

.button--outline {
  background: transparent;
  color: #0f766e;
  border: 2rpx solid #99f6e4;
}

.button-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 24rpx;
}

.stat-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 24rpx;
}

.stat-card {
  border-radius: 24rpx;
  padding: 20rpx;
  background: #f8fafc;
}

.stat-label {
  color: #64748b;
  font-size: 24rpx;
}

.stat-value {
  margin-top: 12rpx;
  font-size: 40rpx;
  font-weight: 800;
  color: #0f172a;
}

.field-label {
  display: block;
  margin-bottom: 12rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #334155;
}

.input,
.textarea,
.picker {
  width: 100%;
  box-sizing: border-box;
  border-radius: 20rpx;
  padding: 22rpx 20rpx;
  background: #f8fafc;
  border: 2rpx solid #e2e8f0;
  font-size: 28rpx;
}

.textarea {
  min-height: 180rpx;
}

.help {
  margin-top: 10rpx;
  color: #64748b;
  font-size: 22rpx;
  line-height: 1.7;
}

.notice {
  border-radius: 24rpx;
  padding: 20rpx 22rpx;
  background: #ecfeff;
  color: #155e75;
  font-size: 24rpx;
  line-height: 1.7;
}

.order-card {
  border-radius: 24rpx;
  padding: 24rpx;
  background: #ffffff;
  border: 2rpx solid #e2e8f0;
}

.order-title {
  font-size: 30rpx;
  font-weight: 700;
}

.order-meta {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.8;
  color: #64748b;
}

.order-badge {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #dcfce7;
  color: #166534;
  font-size: 22rpx;
  font-weight: 700;
}

.tab-row {
  display: flex;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.tab-chip {
  padding: 14rpx 22rpx;
  border-radius: 999rpx;
  background: #eef2ff;
  color: #475569;
  font-size: 24rpx;
}

.tab-chip--active {
  background: #0f766e;
  color: #ffffff;
}

.empty {
  padding: 32rpx 24rpx;
  border-radius: 24rpx;
  background: #f8fafc;
  color: #94a3b8;
  font-size: 24rpx;
  text-align: center;
}

.avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #d1fae5 0%, #bfdbfe 100%);
}

.profile-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.price {
  font-size: 36rpx;
  font-weight: 800;
  color: #0f766e;
}
